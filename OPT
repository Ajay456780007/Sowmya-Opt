classdef Optimizations
    properties
        n_bus; n; busdata; linedata; Pg; Qg; all_dat; min_; max_; sel; max1, max2; nev; ndg;n_approach;nn
  
    end
    methods
        function [fitval] = fit_fun_SSSC(obj, sol)
        
            if size(sol,2) == 1
                sol = sol';
            end
        
            if mod(length(sol),2) ~= 0
                error(['Invalid SSSC solution length. ', ...
                       'Solution must contain [LineNumber CompensationRatio] ', ...
                       'pairs.']);
            end
        
            LineNo = round(sol(1:2:end));
        
            Compensation = sol(2:2:end);

        
            if obj.n_bus == 14
        
                all_data1 = obj.all_dat;
        
            elseif obj.n_bus == 30
        
                all_data1 = obj.all_dat;
        
            else
        
                error('SSSC fitness function currently supports IEEE 14 and IEEE 30 bus systems.');
        
            end
        
        
            %% ================================================================
            % NUMBER OF TRANSMISSION LINES
            % ================================================================
        
            NumberOfLines = size(all_data1.branch,1);
        
            LineNo = max(1,min(LineNo,NumberOfLines));
        
        
            Compensation = max(-0.80,min(Compensation,0.80));
        
        
            %% ================================================================
            % APPLY SSSC SERIES COMPENSATION
            % ================================================================
        
            for i = 1:length(LineNo)
        
                line_idx = LineNo(i);
        
                % Original series reactance
                X_original = all_data1.branch(line_idx,4);
        
                % Avoid zero reactance
                if abs(X_original) < 1e-12
                    X_original = 1e-6;
                end
        
                % ------------------------------------------------------------
                % SSSC equivalent series reactance
                %
                % X_new = X_original * (1 - compensation)
                %
                % Example:
                %
                % Compensation = 0.30
                % X_new = 0.70 * X_original
                %
                % Compensation = -0.30
                % X_new = 1.30 * X_original
                % ------------------------------------------------------------
        
                X_new = X_original * (1 - Compensation(i));
        
                % Prevent zero/negative reactance
                X_new = max(X_new,0.05*abs(X_original));
        
                % Update branch reactance
                all_data1.branch(line_idx,4) = X_new;
        
            end
        
        
            %% ================================================================
            % RUN POWER FLOW
            % ================================================================
        
            if obj.n_bus == 14 || obj.n_bus == 30
        
                [Plosskw, Qlosskw, PL, QL, voltage, angle_all,T_power_loss,AVDI, AVSI, volt_dev, Voltage_min, Voltage_max, Ploss_branch, ...
                 Qloss_branch, ATC_per_bus, all_cost] = ...
                    Load_flow_base1( all_data1, obj.n_approach, obj.n_bus, obj.nn);
        
            end
       
        
            if isempty(ATC_per_bus)
                ATC = 0;
            else
                ATC = mean(ATC_per_bus,'omitnan');
            end
        
        
            % Avoid division by zero
            if isnan(ATC) || isinf(ATC) || ATC <= 0
                ATC = 1e-6;
            end
        
        
            if isnan(T_power_loss) || isinf(T_power_loss)
                T_power_loss = 1e6;
            end
        
        
            if isnan(AVSI) || isinf(AVSI)
                AVSI = 1e6;
            end
        
            fitval = (1/ATC) + T_power_loss + (1/AVSI);
        
            if obj.n_approach == 1
                p_loss_cost = T_power_loss * 100
                e_loss_cost = (T_power_loss * 24 / 1000) * 100;
                v_stab_cost = AVSI * 100;
                fitval = p_loss_cost + e_loss_cost + v_stab_cost;  
            end
        
            if obj.n_approach == 2
                fitval = (1/ATC) + T_power_loss + (1/AVSI);
            end
            if isnan(fitval) || isinf(fitval)
                fitval = 1e10;
        
            end
        
        end
        
        function [fitval]=fit_fun_EV(obj, sol)
            if size(sol, 2)==1
               sol=sol'; 
            end
            N_bus = round(sol(1:2:end));
%             N_bus = get_val(N_bus,1,obj.n_bus);
            n1 = numel(N_bus);
            C = setxor(N_bus,1:n1);
            [U, id] = unique(N_bus);
            ix = setxor(id,1:n1);
            N_bus(ix) = C(randperm(numel(ix)));
            in_power = sol(2:2:end);
            in_power = get_val1(in_power, obj.min_, obj.max_);
            in_power(in_power==0)=0+rand(1,1)*(obj.max_-0);
            in_power = (in_power/sum(in_power))*obj.max_;
            if obj.n_bus ==14 || obj.n_bus==30
                all_data1=obj.all_dat;
                for i = 1: size(N_bus, 2)
                    ff = find(all_data1.bus(:,1)==N_bus(i));
                    if ff ~= 0
                        all_data1.bus(ff, 3) =  all_data1.bus(ff, 3) + in_power(i);
                    end
                end
                [Plosskw, Qlosskw, PL, QL, voltage, angle_all, T_power_loss, AVDI, AVSI , all_cost]=Load_flow_base1(all_data1, obj.n_approach, obj.n_bus, obj.nn);
            end
            if obj.n_bus ==33 || obj.n_bus == 69
                busdata_=obj.busdata;
                for i =1:size(N_bus,2)
                    busdata_(N_bus(i), 2) = busdata_(N_bus(i), 2)+(in_power(i));
                end
                [Plosskw, Qlosskw, PL, QL, voltage, angle_all, T_power_loss, AVDI, AVSI, all_cost]=Load_flow_base(obj.n_bus, busdata_, obj.linedata, obj.Pg, obj.Qg, obj.n_approach, obj.nn);
            end
            fitval= T_power_loss+AVDI+(1/AVSI);
            if obj.n_approach == 1
%                 p_loss_cost = T_power_loss*100; %% Calaculating Power loss cost
%                 e_loss_cost = (T_power_loss*24/1000)*100; %%Calculating Energy loss cost for 24hrs
%                 v_stab_cost = AVSI*100; %% Calculating Voltage stability cost
%                 fitval = p_loss_cost+e_loss_cost+v_stab_cost;
            elseif obj.n_approach == 2
%                 chr_cost = length(N_bus)*100;    %% Charging Cost
%                 oper_cost = sum(in_power)*100;  %% Operating Cost
%                 ins_cost = length(N_bus)*500; %% Installation Cost
%                 Main_cost = length(N_bus)*500; %% Maintance Cost
%                 fitval = chr_cost+oper_cost+ins_cost+Main_cost;
            end

        end
        

